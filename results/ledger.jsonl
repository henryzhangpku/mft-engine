{"seq":14,"recorded_at":"2026-10-06T15:25:59Z","prev_hash":"69473baa4317bdcde1f08c642316185e94e97dba2287d258b1129110f4d47c2f","hash":"07353dfbc667d00972798ae5c8743034db406a09c967e6e8010ebdff1bbbcd0e","variant":"v4_funding_carry","hypothesis":"Shorting the perps whose longs paid the most funding over the last 3 days and buying those whose longs paid the least, dollar-neutral and rebalanced daily, earns more in hourly funding than it loses in fees, slippage and the price leg, on the sealed last 40% of a 90-day window.","base":"v4","overrides":{"bucket_size":6,"fills":{"slippage_bps":3.0,"taker_fee_bps":4.5},"gross_notional":10000.0,"lookback_hours":72,"min_funding_coverage":0.9,"min_trade_notional":50.0,"rebalance_every_hours":24,"stale_price_hours":2,"vol_lookback_hours":168,"weighting":"equal"},"experiment_file_sha256":"e229ed1c5b0439efe97e603f4f096a8699afbe044e687d946f0a072823a1d23f","data_files":["data/carry_1h_bars.jsonl","data/carry_funding_1h.jsonl","data/carry_universe.json"],"data_sha256":"3c7496b55e908f55ea8bc3bd72f8c6370ee157f996655d4192fd7c4519548c6c","verdict":"preregistered","verdict_rule":"Killed if, on the sealed out-of-sample window, net Sharpe (daily P&L, annualised with sqrt(365)) <= 0 or net P&L after fees, slippage and funding <= 0. Otherwise kept, which means not refuted on this sample, not proven.","result":{"config_hash":"1d569a054c3f66c9ad94987504f215cf2fc4b88af95e34b58ed8940d77857f3f","note":"Written before any v4 backtest on real data. Parameters chosen from the mechanism (3-day funding persistence, daily rebalancing to limit turnover, quintile buckets of a 30-coin universe, equal weights), not from results.","phase":"preregistered","spec":{"bars":"data/carry_1h_bars.jsonl","benchmark":"BTC","bootstrap":{"block_days":5,"resamples":10000,"seed":20261006},"capital_note":"Returns are on gross notional ($10,000: $5,000 long, $5,000 short), as if the full notional were posted as margin (1x, no leverage). Paper fills at the hourly close plus slippage; no borrow cost exists for perps (funding is the carry); margin interest and liquidation are not modelled.","funding":"data/carry_funding_1h.jsonl","hypothesis":"Shorting the perps whose longs paid the most funding over the last 3 days and buying those whose longs paid the least, dollar-neutral and rebalanced daily, earns more in hourly funding than it loses in fees, slippage and the price leg, on the sealed last 40% of a 90-day window.","in_sample_fraction":0.6,"kill_rule":"Killed if, on the sealed out-of-sample window, net Sharpe (daily P&L, annualised with sqrt(365)) <= 0 or net P&L after fees, slippage and funding <= 0. Otherwise kept, which means not refuted on this sample, not proven.","max_design_choices":2,"name":"v4_funding_carry","params":{"bucket_size":6,"fills":{"slippage_bps":3.0,"taker_fee_bps":4.5},"gross_notional":10000.0,"lookback_hours":72,"min_funding_coverage":0.9,"min_trade_notional":50.0,"rebalance_every_hours":24,"stale_price_hours":2,"vol_lookback_hours":168,"weighting":"equal"},"rationale":"Hyperliquid perps settle funding every hour; a positive rate means longs pay shorts. Persistently high funding marks a crowded, leveraged long side that pays to stay in; the other side is paid to supply that exposure. Funding is persistent hour to hour, so the trailing rate forecasts the next day's payment. The known risk is the price leg: crowded longs are often in coins that keep rising (momentum), and squeezes hit shorts hardest. Dollar neutrality removes the market direction, not the coin-specific moves.","universe":"data/carry_universe.json"},"universe":["BTC","ETH","HYPE","SOL","ZEC","LIT","XRP","NEAR","WLD","PUMP","FARTCOIN","XPL","SUI","VVV","AAVE","kBONK","ADA","kPEPE","DOGE","ENA","BNB","TAO","LINK","MORPHO","JTO","BCH","DYDX","AVAX","UNI","XMR"],"universe_rule":"Every main-dex perp in the metadata at fetch time (listed or delisted), ranked by dollar volume (sum of hourly volume x close) over the formation window; the top 30 with at least 90% of formation hours present form the universe for the whole window. Builder (HIP-3) dexes excluded.","window":{"data_start":"2026-07-01T00:00:00Z","formation_end_trading_start":"2026-07-08T00:00:00Z","in_sample":["2026-07-08T00:00:00Z","2026-08-31T00:00:00Z"],"in_sample_days":54,"out_of_sample_sealed":["2026-08-31T00:00:00Z","2026-10-06T00:00:00Z"],"trading_days":90}}}
